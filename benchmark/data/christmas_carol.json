  "targets": [
    {
      "name": "Ebenezer Scrooge",
      "description": "A miserly London businessman who is transformed by four ghostly visits on Christmas Eve.",
      "physical_description": "Old, thin, with a pointed nose, shrivelled cheek, red eyes, thin blue lips, and frosty white hair.",
      "known_as": [
        "Scrooge",
        "Ebenezer"
      ],
      "summary_of_actions": "Rejects Christmas, is visited by Marley and three Spirits, repents, and becomes generous."
    },
    {
      "name": "Jacob Marley",
      "description": "Scrooge's dead business partner who returns as a ghost to warn him.",
      "physical_description": "A transparent ghost bound in a long chain of cash-boxes, keys, padlocks and ledgers.",
      "known_as": [
        "Marley",
        "Jacob Marley"
      ],
      "summary_of_actions": "Appears to Scrooge, warns him of his fate, and announces the three Spirits."
    },
    {
      "name": "Bob Cratchit",
      "description": "Scrooge's poorly paid, good-hearted clerk.",
      "physical_description": "Wears a threadbare comforter in place of a greatcoat.",
      "known_as": [
        "Bob",
        "Bob Cratchit"
      ],
      "summary_of_actions": "Works in the cold office, celebrates a humble Christmas with his family, and mourns Tiny Tim in a vision of the future."
    },
    {
      "name": "Mrs. Cratchit",
      "description": "Bob Cratchit's wife.",
      "physical_description": "Dressed in a twice-turned gown, brave in ribbons.",
      "known_as": [
        "Mrs. Cratchit"
      ],
      "summary_of_actions": "Prepares the family's Christmas dinner and reluctantly toasts Scrooge."
    },
    {
      "name": "Tiny Tim",
      "description": "Bob Cratchit's youngest son, sickly and kind.",
      "physical_description": "A small, lame boy who carries a little crutch and has his limbs supported by an iron frame.",
      "known_as": [
        "Tiny Tim"
      ],
      "summary_of_actions": "Says 'God bless Us, Every One!' and, in a future vision, has died; after Scrooge reforms, he does not die."
    },
    {
      "name": "Martha Cratchit",
      "description": "Bob Cratchit's eldest daughter, an apprentice at a milliner's.",
      "physical_description": "Not described.",
      "known_as": [
        "Martha"
      ],
      "summary_of_actions": "Comes home late for Christmas dinner and hides to tease her father."
    },
    {
      "name": "Peter Cratchit",
      "description": "Bob Cratchit's son.",
      "physical_description": "Wears his father's oversized shirt collar.",
      "known_as": [
        "Peter"
      ],
      "summary_of_actions": "Helps with the Christmas dinner and reads to the family in the future vision."
    },
    {
      "name": "Belinda Cratchit",
      "description": "Bob Cratchit's second daughter.",
      "physical_description": "Brave in ribbons.",
      "known_as": [
        "Belinda"
      ],
      "summary_of_actions": "Helps her mother lay the cloth and sweetens the apple-sauce."
    },
    {
      "name": "Fred",
      "description": "Scrooge's cheerful nephew, son of his late sister Fan.",
      "physical_description": "Handsome, with a ruddy face and sparkling eyes.",
      "known_as": [
        "Fred"
      ],
      "summary_of_actions": "Invites Scrooge to Christmas dinner, hosts a party with games, and welcomes Scrooge when he finally comes."
    },
    {
      "name": "Ghost of Christmas Past",
      "description": "The first of the three Spirits, who shows Scrooge scenes from his own past.",
      "physical_description": "A strange figure like a child yet like an old man, with a bright jet of light from its crown, white hair, and a white tunic.",
      "known_as": [
        "Ghost of Christmas Past"
      ],
      "summary_of_actions": "Shows Scrooge his lonely school days, Fezziwig's ball, and his parting with Belle."
    },
    {
      "name": "Ghost of Christmas Present",
      "description": "The second Spirit, who shows Scrooge Christmas as it is being celebrated now.",
      "physical_description": "A jolly giant in a green robe bordered with white fur, wearing a holly wreath.",
      "known_as": [
        "Ghost of Christmas Present"
      ],
      "summary_of_actions": "Shows Scrooge the Cratchits, Fred's party, and the children Ignorance and Want."
    },
    {
      "name": "Ghost of Christmas Yet to Come",
